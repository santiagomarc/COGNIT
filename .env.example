# Supabase configuration (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production site URL (required in production to prevent host-header poisoning)
NEXT_PUBLIC_SITE_URL=https://cognit.study

# Google Gemini API key for flashcard generation, chat, and enrichment
GEMINI_API_KEY=your-gemini-api-key

# Optional: Override Gemini model (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Secret token for /api/keep-alive endpoint (required in production)
CRON_SECRET=your-cron-secret

# Optional: enables account deletion in Settings (server-only; set in Vercel Production only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: a dedicated test account for `npm run e2e` and the k6 load test (never a real user)
# LOAD_TEST_EMAIL=test-account@example.com
# LOAD_TEST_PASSWORD=your-test-password
